# TCM-History-AI 本地开发依赖环境变量样例
# 用法：cp .env.example .env 后按需修改；docker compose 会自动加载同目录 .env

# ========== PostgreSQL 16 ==========
# 数据库账号
POSTGRES_USER=tcm
# 数据库密码
POSTGRES_PASSWORD=tcm_pass
# 默认数据库名
POSTGRES_DB=tcm_history
# 宿主机映射端口
POSTGRES_PORT=5432

# ========== Redis 7 ==========
# 访问密码
REDIS_PASSWORD=redis_pass
# 宿主机映射端口
REDIS_PORT=6379

# ========== Neo4j 5 ==========
# 认证信息，格式 user/password
NEO4J_AUTH=neo4j/neo4j_pass
# HTTP（Browser）端口
NEO4J_HTTP_PORT=7474
# Bolt 协议端口
NEO4J_BOLT_PORT=7687

# ========== MinIO ==========
# 管理员账号
MINIO_ROOT_USER=minio
# 管理员密码
MINIO_ROOT_PASSWORD=minio_pass
# S3 API 端口
MINIO_API_PORT=9000
# 控制台端口
MINIO_CONSOLE_PORT=9001

# ========== Milvus 2.4 ==========
# gRPC 服务端口
MILVUS_PORT=19530
# 健康检查 / Metrics 端口
MILVUS_MANAGEMENT_PORT=9091

# ========== Meilisearch ==========
# 主密钥（开发环境，请勿用于生产）
MEILI_MASTER_KEY=meili_master_key_dev
# HTTP 端口
MEILI_PORT=7700

# ========== RabbitMQ 3.13 ==========
# 默认用户名（与 definitions.json 中 tcm 用户一致）
RABBITMQ_DEFAULT_USER=tcm
# 默认密码
RABBITMQ_DEFAULT_PASS=tcm_pass
# 默认 vhost
RABBITMQ_DEFAULT_VHOST=/tcm
# AMQP 端口
RABBITMQ_AMQP_PORT=5672
# 管理控制台端口
RABBITMQ_MANAGEMENT_PORT=15672
