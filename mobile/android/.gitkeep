# Android 平台目录占位。
#
# 实际 Android 工程由 `flutter create --platforms=android .` 生成：
#   android/
#   ├── app/
#   │   ├── build.gradle              # 应用级 Gradle 配置
#   │   └── src/main/
#   │       ├── AndroidManifest.xml
#   │       ├── kotlin/.../MainActivity.kt
#   │       └── res/                  # 启动图、应用图标、strings.xml
#   ├── build.gradle                  # 项目级 Gradle 配置
#   ├── gradle.properties
#   ├── local.properties              # SDK 路径（gitignore）
#   └── settings.gradle
#
# 网络配置注意：app/src/main/AndroidManifest.xml 需在 <application> 加
#   android:usesCleartextTraffic="true"
# 以允许开发期访问 10.0.2.2:8080 的明文 HTTP 后端。
