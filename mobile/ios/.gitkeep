# iOS 平台目录占位。
#
# 实际 iOS 工程由 `flutter create --platforms=ios .` 生成（需 macOS 宿主 + Xcode）：
#   ios/
#   ├── Runner/
#   │   ├── AppDelegate.swift
#   │   ├── Base.lproj/LaunchScreen.storyboard
#   │   ├── Info.plist
#   │   └── Assets.xcassets/         # AppIcon + LaunchImage
#   ├── Runner.xcodeproj/
#   ├── Runner.xcworkspace/
#   └── Podfile                       # CocoaPods 依赖（首次 flutter run 自动生成）
#
# 网络配置注意：Info.plist 需在 <dict> 下加 NSAppTransportSecurity 允许
# 开发期访问明文 HTTP 后端：
#   <key>NSAppTransportSecurity</key>
#   <dict>
#     <key>NSAllowsArbitraryLoads</key>
#     <true/>
#   </dict>
