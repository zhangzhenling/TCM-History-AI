{
  "name": "tcm-history-ai-web",
  "version": "0.1.0",
  "private": true,
  "description": "TCM-History-AI 前端 monorepo（学习端 + 后台 + 共享包）",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @tcm/learner dev",
    "dev:admin": "pnpm --filter @tcm/admin dev",
    "build": "pnpm --filter @tcm/learner build",
    "build:admin": "pnpm --filter @tcm/admin build",
    "typecheck": "pnpm -r --filter=./packages/* --filter=@tcm/learner typecheck",
    "lint": "eslint --ext .ts,.tsx,.vue .",
    "lint:fix": "eslint --ext .ts,.tsx,.vue . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,json,md,less,css}\"",
    "clean": "pnpm -r exec rimraf dist node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.9",
    "typescript": "^5.5.4"
  }
}
